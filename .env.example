PORT=3001
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_API_KEY=
# The key is read by the backend only. Never expose it with a VITE_ prefix.

# Frontend build setting: backend origin only, without /api.
# Leave blank when Express serves the frontend or during local development.
VITE_API_BASE_URL=
# Enable the temporary portfolio demo notice in the frontend build.
VITE_TEMPORARY_DEMO=false
# Restore sample records on an empty database at container startup.
SEED_DEMO_DATA=false
# Persistent paths for a hosted backend (optional locally).
# DATABASE_URL=file:/app/storage/docuintel.db
# UPLOAD_DIR=/app/storage/uploads
